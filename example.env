# trumpet-rss — environment template
# Copy to `.env` and fill in. The container reads it via `--env-file .env`.

# --- Mastodon access tokens ---------------------------------------------------
# One per account in config.yaml. The variable name must match `token_env`.
TRUMPET_TOKEN_MYACCOUNT=
TRUMPET_TOKEN_SECONDARY=

# --- API authentication ------------------------------------------------------
# A long, unique random string. Rotate to invalidate all issued tokens.
TRUMPET_JWT_SECRET=change-me-to-a-long-random-string

# Token lifetime in seconds (default 28800 = 8 hours).
TRUMPET_JWT_TTL=28800

# Comma-separated list of `username:bcryptHash` pairs.
# Generate a hash with:  bin/trumpet hash-password <password> [username]
#
# IMPORTANT: when this file is loaded via `docker compose` / `podman compose`
# (env_file:), every `$` is interpolated and must be doubled to `$$`. With
# plain `podman run --env-file .env` the value is literal — halve the `$$`.
#
# Example below is the bcrypt of "admin" (cost 12) — DO NOT use in production.
TRUMPET_USERS=admin:$$2y$$12$$ou7IWXt4jZAWhfVbsX2qquABXKtLlCXvo47mKqJtW/NnC0rqqoJSa

# --- LDAP / Active Directory (optional) --------------------------------------
# Uncomment to enable. When TRUMPET_LDAP_URL is empty, LDAP is fully disabled
# and only TRUMPET_USERS is consulted. With LDAP enabled, login tries local
# users first (emergency admin), then LDAP as fallback.
#TRUMPET_LDAP_URL=ldaps://dc1.corp.local:636        # ldap:// or ldaps://
#TRUMPET_LDAP_STARTTLS=0                            # 1 = STARTTLS on ldap://
#TRUMPET_LDAP_TLS_VERIFY=1                          # 0 = skip cert check (lab only)
#TRUMPET_LDAP_CA_FILE=                              # optional CA bundle path inside the container
#
#TRUMPET_LDAP_BIND_DN=CN=trumpet-svc,OU=Service Accounts,DC=corp,DC=local
#TRUMPET_LDAP_BIND_PASSWORD=
#
#TRUMPET_LDAP_BASE_DN=DC=corp,DC=local
#TRUMPET_LDAP_USER_FILTER=(sAMAccountName={user})   # {user} = ldap-escaped username
#
# Allowed admin groups. DNs contain commas, so use `;` to separate multiple DNs.
#TRUMPET_LDAP_ADMIN_GROUPS=CN=TrumpetAdmins,OU=Groups,DC=corp,DC=local

# --- Misc --------------------------------------------------------------------
TRUMPET_LOG_LEVEL=info
TZ=Europe/Prague
